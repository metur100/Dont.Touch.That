{
  "expo": {
    "name": "Don't Touch That!",
    "slug": "dont-touch-that",
    "version": "1.0.0",
    "scheme": "donttouchthat",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF4E0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.certidevelopment.donttouchthat",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMotionUsageDescription": "Some levels check whether you shake your phone. (Spoiler: don't.)"
      }
    },
    "android": {
      "package": "com.certidevelopment.donttouchthat",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF4E0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF4E0",
          "dark": {
            "backgroundColor": "#1B1033"
          }
        }
      ],
      "expo-system-ui",
      "./plugins/withStableAndroidBuild",
      "./plugins/withReleaseSigning",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "22078912-bc23-486b-91b9-57d05951246b"
      }
    },
    "owner": "certi-development"
  }
}
